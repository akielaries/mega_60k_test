module Gowin_PLL_MOD (
  HCLK,
  rRstOut,
  rMdInc,
  rMdOpc,
  rMdDOut,
  pll_lock,
  GTX_CLK,
  EPHY_CLK_d,
  DDR_MEM_CLK,
  wMdQOut
)
;
input HCLK;
input rRstOut;
input rMdInc;
input [1:0] rMdOpc;
input [7:0] rMdDOut;
output pll_lock;
output GTX_CLK;
output EPHY_CLK_d;
output DDR_MEM_CLK;
output [7:0] wMdQOut;
