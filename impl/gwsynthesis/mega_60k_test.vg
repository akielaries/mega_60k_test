input n54_5;
input slave_PRDATA_31_3;
input wr_req_9;
input rd_req_7;
input master_PSEL;
input [2:2] mux_PADDR;
input [31:0] mux_PWDATA;
input [2:2] APB1PADDR;
input [2:2] gwct_PADDR;
output wr_req_d0;
output rd_ack;
output [31:0] gpio_prdata;
wire VCC;
wire GND;
  gpio_regs u_regs (
    .APB1PCLK(APB1PCLK),
    .n54_5(n54_5),
    .slave_PRDATA_31_3(slave_PRDATA_31_3),
    .wr_req_9(wr_req_9),
    .rd_req_7(rd_req_7),
    .master_PSEL(master_PSEL),
    .mux_PADDR(mux_PADDR[2]),
    .mux_PWDATA(mux_PWDATA[31:0]),
    .APB1PADDR(APB1PADDR[2]),
    .gwct_PADDR(gwct_PADDR[2]),
    .wr_req_d0(wr_req_d0),
    .rd_ack(rd_ack),
    .gpio_prdata(gpio_prdata[31:0])
